<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <!-- Published by `npm run build:host` as one self-contained file inside the app's resources. -->
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    <!-- SQLite's native library goes inside that file too, unpacked on first run: which SDK publishes it
         decides nothing about what the app ships next to the sidecar. -->
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <!-- Not hosted by IIS and serves no static files. -->
    <PublishIISAssets>false</PublishIISAssets>
    <IsTransformWebConfigDisabled>true</IsTransformWebConfigDisabled>
    <StaticWebAssetsEnabled>false</StaticWebAssetsEnabled>
    <DebugType Condition="'$(Configuration)' == 'Release'">embedded</DebugType>
  </PropertyGroup>

  <ItemGroup>
    <!-- Measurements that replay records through Gil with the sidecar's own forms and documents. -->
    <InternalsVisibleTo Include="Lowline.Host.Tests" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Formbase.Core" Version="0.34.0" />
    <PackageReference Include="Formbase.Sqlite" Version="0.34.0" />
    <PackageReference Include="Formbase.DependencyInjection" Version="0.34.0" />
    <PackageReference Include="Formbase.Formdown" Version="0.34.0" />
    <PackageReference Include="Lowline" Version="0.8.0" />
    <PackageReference Include="IronProw.Core" Version="0.18.0" />
    <PackageReference Include="IronProw.IronHive" Version="0.18.0" />
    <PackageReference Include="IronProw.LMSupply" Version="0.18.0" />
    <PackageReference Include="LMSupply.Generator" Version="0.137.0" />
    <PackageReference Include="FluxIndex.SDK" Version="0.104.0" />
    <PackageReference Include="FluxIndex.Storage.SQLite" Version="0.104.0" />
    <PackageReference Include="TauriKit.Sidecar.Loopback.AspNetCore" Version="0.29.0" />
    <PackageReference Include="DesktopHost.Files" Version="0.5.0" />
    <PackageReference Include="Undoc" Version="0.27.1" />
    <PackageReference Include="Unhwp" Version="0.23.1" />
    <PackageReference Include="Unpdf" Version="0.51.0" />
  </ItemGroup>

</Project>
