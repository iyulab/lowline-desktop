{
  "name": "lowline",
  "version": "0.3.0",
  "private": true,
  "description": "A local form editor that learns from your confirmations",
  "license": "AGPL-3.0-only",
  "type": "module",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "prebuild:host": "node scripts/clean-host.ts",
    "postbuild:host": "npm run notices",
    "build:host": "dotnet publish src-host/Lowline.Host -c Release -r win-x64 --self-contained -p:PublishSingleFile=true -o src-host/publish",
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "typecheck": "tsc --noEmit",
    "test": "vitest run && desktop-compact-check-tokens --defined node_modules/@iyulab/desktop-patterns/tokens.css --defined src/styles.css src",
    "build:e2e": "tauri build --debug --no-bundle --config src-tauri/tauri.e2e.conf.json",
    "test:e2e": "node e2e/run.mjs",
    "check:installer": "node scripts/check-installer.mjs",
    "notices": "tauri-kit-dev notices --config notices/config.mjs",
    "tauri": "tauri",
    "test:host": "dotnet test --project src-host/Lowline.Host.Tests",
    "brand:icons": "node scripts/brand-icons.ts",
    "brand:glyphs": "node scripts/brand-glyphs.ts",
    "brand:sync": "node scripts/brand-sync.ts",
    "brand:og": "node scripts/brand-og.ts",
    "brand:motion": "node scripts/brand-motion.ts",
    "brand:installer": "node scripts/brand-installer.ts",
    "brand": "npm run brand:glyphs && npm run brand:icons && npm run brand:og -- --site ../lowline.site && npm run brand:motion && npm run brand:installer",
    "versions": "tauri-kit-dev versions --config versions.config.mjs"
  },
  "dependencies": {
    "@formdown/core": "^0.21.0",
    "@formdown/ui": "^0.21.0",
    "@iyulab/chat-components": "0.27.4",
    "@iyulab/components": "^2.30.0",
    "@iyulab/desktop-compact": "^0.14.0",
    "@iyulab/desktop-patterns": "^0.11.2",
    "@tauri-apps/api": "^2.12.0",
    "@tauri-apps/plugin-dialog": "^2.8.0",
    "lit": "^3.3.3"
  },
  "devDependencies": {
    "@fontsource/instrument-sans": "5.3.0",
    "@iyulab/tauri-kit-dev": "^0.10.0",
    "@resvg/resvg-js": "2.6.2",
    "@tauri-apps/cli": "^2.12.0",
    "opentype.js": "2.0.0",
    "pretendard": "1.3.9",
    "typescript": "^6.0.3",
    "vite": "^8.3.1",
    "vitest": "^5.0.2"
  }
}
